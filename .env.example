# AI Provider API Keys (at least one required)
# Supports multiple keys per provider — add _1, _2, _3 suffix for additional keys.
# They are tried in order: primary key first, then _1, _2, etc.
# Examples:
#   GEMINI_API_KEY=your-primary-gemini-key
#   GEMINI_API_KEY_1=your-secondary-gemini-key
#   GEMINI_API_KEY_2=your-tertiary-gemini-key
# GEMINI_API_KEY=your-gemini-key
# GROQ_API_KEY=your-groq-key
# GROQ_API_KEY_1=your-secondary-groq-key
# OPENROUTER_API_KEY=your-openrouter-key
# AI_API_KEY=your-openai-compatible-key

# Provider model overrides (optional)
# GEMINI_MODEL=gemini-2.0-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_MODEL=gpt-4o-mini
# AI_MODEL=gpt-4o-mini

# Custom base URL for OpenAI-compatible providers (optional)
# AI_BASE_URL=https://api.openai.com/v1
