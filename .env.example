# AI Provider API Keys (at least one required)
# Supports multiple keys per provider — add _1, _2, _3 suffix for additional keys.
# They are tried in order: primary key first, then _1, _2, etc.
# Examples:
#   GEMINI_API_KEY=your-primary-gemini-key
#   GEMINI_API_KEY_1=your-secondary-gemini-key
#   GEMINI_API_KEY_2=your-tertiary-gemini-key
# GEMINI_API_KEY=your-gemini-key
# GROQ_API_KEY=your-groq-key
# GROQ_API_KEY_1=your-secondary-groq-key
# OPENROUTER_API_KEY=your-openrouter-key
# AI_API_KEY=your-openai-compatible-key
#
# DigitalOcean GenAI examples (if using DO model studio):
#   AI_API_KEY=your_do_pat_token
#   AI_MODEL=qwen3-235b (or deepseek-v3, kimi-k2, etc)
#   AI_BASE_URL=https://inference.do-ai.run/v1

# Provider model overrides (optional — defaults shown when uncommented)
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash-lite-preview-05-08  (cheaper, faster)
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_MODEL=qwen/qwen3-235b-a22b
# AI_MODEL=gpt-4o-mini

# Custom base URL for OpenAI-compatible providers (optional)
# Defaults to https://api.openai.com/v1
# DigitalOcean: AI_BASE_URL=https://inference.do-ai.run/v1
# AI_BASE_URL=https://api.openai.com/v1

# Generation Strategy (optional)
# Options: cheap | balanced | quality
# GENERATION_STRATEGY=balanced

# Per-entity-type model overrides (optional)
# Format: use strategy key from above (cheap | balanced | quality)
# MODEL_FOR_GODS=quality
# MODEL_FOR_KINGDOMS=balanced
# MODEL_FOR_FACTIONS=balanced
# MODEL_FOR_EVENTS=quality
# MODEL_FOR_CITIES=cheap
# MODEL_FOR_RACES=balanced
# MODEL_FOR_MONSTERS=cheap
# MODEL_FOR_RELIGIONS=quality
# MODEL_FOR_ARTIFACTS=balanced
# MODEL_FOR_SPELLS=cheap
