---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Not Found | Aetherion Archive" description="This page does not exist in the canon — yet.">
  <main class="max-w-2xl mx-auto px-4 py-24 text-center">
    <h1 class="text-6xl font-bold text-[#8ab4d4] mb-4">404</h1>
    <p class="text-xl text-stone-400 mb-2">Page Not Found</p>
    <p class="text-stone-500 mb-8">This entity does not exist in the canon — yet.</p>
    <div class="flex flex-wrap gap-3 justify-center">
      <a href="/" class="inline-block border border-[#8ab4d4] text-[#8ab4d4] rounded-lg px-5 py-2.5 text-sm hover:bg-[#8ab4d4]/10 transition-colors">Return Home</a>
      <a href="/god/" class="inline-block border border-stone-600 text-stone-400 rounded-lg px-5 py-2.5 text-sm hover:border-stone-500 transition-colors">Browse Gods</a>
      <a href="/kingdom/" class="inline-block border border-stone-600 text-stone-400 rounded-lg px-5 py-2.5 text-sm hover:border-stone-500 transition-colors">Browse Kingdoms</a>
      <a href="/faction/" class="inline-block border border-stone-600 text-stone-400 rounded-lg px-5 py-2.5 text-sm hover:border-stone-500 transition-colors">Browse Factions</a>
    </div>
  </main>
</BaseLayout>
