---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllEntities } from '../../lib/canon';
import type { Entity, Relationship } from '../../../../src/types/entity';

export interface Props {
  entity: Entity;
  resolvedRelationships: Array<{ target: Entity; relation: Relationship }>;
  unresolvedRelationships: Array<{ targetId: string; relation: Relationship }>;
}

export async function getStaticPaths() {
  const entities = getAllEntities();
  const slugMap = new Map(entities.map(e => [e.slug, e]));
  return entities.map(e => {
    const resolved = e.relationships
      .filter(r => slugMap.has(r.targetId))
      .map(r => ({ target: slugMap.get(r.targetId)!, relation: r }));
    const unresolved = e.relationships.filter(r => !slugMap.has(r.targetId));
    return {
      params: { type: e.type, slug: e.slug },
      props: { entity: e, resolvedRelationships: resolved, unresolvedRelationships: unresolved },
    };
  });
}

const { entity, resolvedRelationships, unresolvedRelationships } = Astro.props;

const statusColors: Record<string, string> = {
  active: 'bg-emerald-600/20 text-emerald-400 border-emerald-600/30',
  deprecated: 'bg-red-600/20 text-red-400 border-red-600/30',
  archived: 'bg-stone-600/20 text-stone-400 border-stone-600/30',
  rewritten: 'bg-amber-600/20 text-amber-400 border-amber-600/30',
};
const statusClass = statusColors[entity.status] || statusColors.active;

const aliasList = Array.isArray(entity.aliases) ? entity.aliases : [];

const entityAny = entity as Record<string, unknown>;
const topRegion = typeof entityAny.region === 'string' ? entityAny.region : null;

function parseAttributes(attrs: unknown): Record<string, unknown> {
  if (!attrs) return {};
  if (typeof attrs === 'string') {
    try { return JSON.parse(attrs); } catch { return {}; }
  }
  if (typeof attrs === 'object' && !Array.isArray(attrs)) {
    return attrs as Record<string, unknown>;
  }
  return {};
}

const rawAttrs = parseAttributes(entity.attributes);
const attrRegion = typeof rawAttrs.region === 'string' ? rawAttrs.region : null;
const region = topRegion || attrRegion;
const era = typeof rawAttrs.era === 'string' ? rawAttrs.era
  : typeof rawAttrs.age === 'string' ? rawAttrs.age
  : typeof rawAttrs.period === 'string' ? rawAttrs.period
  : typeof rawAttrs.founding_date === 'string' ? rawAttrs.founding_date
  : typeof rawAttrs.founded === 'string' ? rawAttrs.founded
  : null;

const hasContent = typeof entity.content === 'string' && entity.content.length > 0 && entity.content !== entity.description;

const contentParagraphs = hasContent
  ? entity.content.split('\n').filter(function(l) { return l.trim(); }).join('\n').split('\n\n').filter(function(p) { return p.trim(); })
  : [];

const skippedAttrKeys = new Set(['region', 'era', 'age', 'period', 'founding_date', 'founded']);

const attributeEntries = Object.entries(rawAttrs).filter(function(entry) {
  const val = entry[1];
  if (skippedAttrKeys.has(entry[0])) return false;
  if (val === null || val === undefined) return false;
  if (typeof val === 'string' && val.trim() === '') return false;
  if (Array.isArray(val) && val.length === 0) return false;
  return true;
});

const hasAttributes = attributeEntries.length > 0;

function attrLabel(key: string): string {
  return key.replace(/_/g, ' ').replace(/\b\w/g, function(c) { return c.toUpperCase(); });
}

function attrValue(val: unknown): string {
  if (val === null || val === undefined) return '';
  if (Array.isArray(val)) return val.map(function(v) { return typeof v === 'object' ? JSON.stringify(v) : String(v); }).join(', ');
  if (typeof val === 'object') return JSON.stringify(val);
  return String(val);
}

function formatRelType(type: string): string {
  return type.replace(/-/g, ' ').replace(/\b\w/g, function(c) { return c.toUpperCase(); });
}
---

<BaseLayout
  title={entity.seo?.title || entity.name}
  description={entity.seo?.metaDescription || entity.excerpt || entity.description}
  url={`https://aetherion-archive.pages.dev/${entity.type}/${entity.slug}`}
  canonicalURL={`https://aetherion-archive.pages.dev/${entity.type}/${entity.slug}`}
>
  <main class="max-w-4xl mx-auto px-4 py-12">

    <div class="mb-8">
      <a href={`/${entity.type}/`} class="text-[#8ab4d4] hover:underline text-sm">&larr; Back to {entity.type}s</a>
    </div>

    <header class="mb-8">
      <h1 class="text-3xl font-bold text-[#8ab4d4] mb-2">{entity.name}</h1>
      <div class="flex flex-wrap gap-2 mb-3">
        <span class="text-xs uppercase tracking-wider text-stone-400 border border-stone-600/30 rounded px-2 py-0.5">{entity.type}</span>
        <span class={`text-xs uppercase tracking-wider border rounded px-2 py-0.5 ${statusClass}`}>{entity.status}</span>
        {region && <span class="text-xs text-stone-500 border border-stone-700/50 rounded px-2 py-0.5">{region}</span>}
        {era && <span class="text-xs text-stone-500 border border-stone-700/50 rounded px-2 py-0.5">{era}</span>}
      </div>
      {aliasList.length > 0 && (
        <div class="flex flex-wrap gap-1.5">
          {aliasList.map(function(a) {
            return <span class="text-xs text-stone-500 bg-stone-800/50 rounded px-2 py-0.5">{a}</span>;
          })}
        </div>
      )}
    </header>

    <section class="mb-8">
      <p class="text-stone-400 leading-relaxed">{entity.description}</p>
      {contentParagraphs.length > 0 && (
        <div class="mt-4 space-y-3">
          {contentParagraphs.map(function(p) {
            return <p class="text-stone-400 leading-relaxed">{p}</p>;
          })}
        </div>
      )}
    </section>

    <section class="mb-8">
      <h2 class="text-lg font-semibold text-stone-200 mb-3">Connections</h2>
      {resolvedRelationships.length > 0 && (
        <ul class="space-y-2 mb-4">
          {resolvedRelationships.map(function(relItem) {
            const rel = relItem.relation;
            const target = relItem.target;
            const relType = typeof rel === 'object' && rel !== null ? rel.type : 'unknown';
            const targetType = typeof target === 'object' && target !== null ? target.type : 'unknown';
            const targetSlug = typeof target === 'object' && target !== null ? target.slug : '';
            const targetName = typeof target === 'object' && target !== null ? target.name : '';
            return <li class="text-stone-400">
              <span class="text-stone-500 text-xs uppercase tracking-wider">{relType}</span>
              <span class="text-stone-600 mx-2">&rarr;</span>
              <a href={`/${targetType}/${targetSlug}`} class="text-[#8ab4d4] hover:underline">{targetName}</a>
              <span class="text-stone-600 text-sm ml-1">({targetType})</span>
            </li>;
          })}
        </ul>
      )}
      {unresolvedRelationships.length > 0 && (
        <div>
          <p class="text-xs uppercase tracking-wider text-stone-600 mb-2">Not yet in canon</p>
          <ul class="space-y-1">
            {unresolvedRelationships.map(function(relItem) {
              const rel = relItem.relation;
              const relType = typeof rel === 'object' && rel !== null ? rel.type : 'unknown';
              return <li class="text-stone-600 text-sm">
                <span class="text-stone-500 text-xs uppercase tracking-wider">{relType}</span>
                <span class="text-stone-700 mx-2">&rarr;</span>
                <span class="text-stone-500">{relItem.targetId}</span>
                <span class="text-stone-600 ml-2 italic">&mdash; not yet in canon</span>
              </li>;
            })}
          </ul>
        </div>
      )}
      {resolvedRelationships.length === 0 && unresolvedRelationships.length === 0 && (
        <p class="text-stone-600 italic text-sm">No known connections.</p>
      )}
    </section>

    {hasAttributes && (
      <details class="mb-8 border border-stone-800 rounded-lg group">
        <summary class="cursor-pointer text-stone-200 font-semibold px-4 py-3 hover:bg-stone-900/50 rounded-lg transition-colors list-none flex items-center gap-2 [&::-webkit-details-marker]:hidden">
          <span class="text-[#8ab4d4] text-xs transition-transform group-open:rotate-90">&rarr;</span>
          Attributes
        </summary>
        <div class="px-4 pb-4">
          <dl class="divide-y divide-stone-800/50">
            {attributeEntries.map(function(entry) {
              const key = entry[0];
              const val = entry[1];
              return <div class="py-2 grid grid-cols-1 sm:grid-cols-[10rem_1fr] gap-1 sm:gap-3">
                <dt class="text-xs uppercase tracking-wider text-stone-500">{attrLabel(key)}</dt>
                <dd class="text-stone-300 text-sm">{attrValue(val)}</dd>
              </div>;
            })}
          </dl>
        </div>
      </details>
    )}

  </main>

  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    name: entity.name,
    description: entity.description,
    url: `https://aetherion-archive.pages.dev/${entity.type}/${entity.slug}`,
    datePublished: entity.createdAt,
    dateModified: entity.updatedAt,
    publisher: {
      "@type": "Organization",
      name: "Aetherion Archive"
    }
  })}></script>
</BaseLayout>
