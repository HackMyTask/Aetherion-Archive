---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllEntities } from '../../lib/canon';
import type { Entity, Relationship } from '../../../../src/types/entity';

export interface Props {
  entity: Entity;
  resolvedRelationships: Array<{ target: Entity; relation: Relationship }>;
  unresolvedRelationships: Array<{ targetId: string; relation: Relationship }>;
}

export async function getStaticPaths() {
  const entities = getAllEntities();
  const slugMap = new Map(entities.map(e => [e.slug, e]));
  return entities.map(e => {
    const resolved = e.relationships
      .filter(r => slugMap.has(r.targetId))
      .map(r => ({ target: slugMap.get(r.targetId)!, relation: r }));
    const unresolved = e.relationships.filter(r => !slugMap.has(r.targetId));
    return {
      params: { type: e.type, slug: e.slug },
      props: { entity: e, resolvedRelationships: resolved, unresolvedRelationships: unresolved },
    };
  });
}

const { entity, resolvedRelationships, unresolvedRelationships } = Astro.props;

const statusBadge: Record<string, string> = {
  active: 'bg-emerald-600/15 text-emerald-400 border-emerald-600/20',
  deprecated: 'bg-red-600/15 text-red-400 border-red-600/20',
  archived: 'bg-stone-600/15 text-stone-400 border-stone-600/20',
  rewritten: 'bg-amber-600/15 text-amber-400 border-amber-600/20',
};

const aliasList = Array.isArray(entity.aliases) ? entity.aliases : [];

const raw = entity as Record<string, unknown>;
const topRegion = typeof raw.region === 'string' ? raw.region : null;
const attrObj = entity.attributes && typeof entity.attributes === 'object' && !Array.isArray(entity.attributes)
  ? (entity.attributes as Record<string, unknown>)
  : {};

const attrRegion = typeof attrObj.region === 'string' ? attrObj.region : null;
const region = topRegion || attrRegion;

const era = typeof attrObj.era === 'string' ? attrObj.era
  : typeof attrObj.age === 'string' ? attrObj.age
  : typeof attrObj.period === 'string' ? attrObj.period
  : typeof attrObj.founding_date === 'string' ? attrObj.founding_date
  : typeof attrObj.founded === 'string' ? attrObj.founded
  : null;

const hasContent = typeof entity.content === 'string' && entity.content.length > 0 && entity.content !== entity.description;

const contentParagraphs = hasContent
  ? entity.content.split('\n').filter(l => l.trim()).join('\n').split('\n\n').filter(p => p.trim())
  : [];

const skippedKeys = new Set(['region', 'era', 'age', 'period', 'founding_date', 'founded']);

const attrEntries = Object.entries(attrObj).filter(([k, v]) => {
  if (skippedKeys.has(k)) return false;
  if (v === null || v === undefined) return false;
  if (typeof v === 'string' && v.trim() === '') return false;
  if (Array.isArray(v) && v.length === 0) return false;
  return true;
});

function attrLabel(k: string): string {
  return k.replace(/_/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
}

function attrVal(v: unknown): string {
  if (v === null || v === undefined) return '';
  if (Array.isArray(v)) return v.map(x => typeof x === 'object' ? JSON.stringify(x) : String(x)).join(', ');
  if (typeof v === 'object') return JSON.stringify(v);
  return String(v);
}

function relTypeLabel(t: string): string {
  return t.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
}
---

<BaseLayout
  title={entity.seo?.title || entity.name}
  description={entity.seo?.metaDescription || entity.excerpt || entity.description}
  url={`https://aetherion-archive.pages.dev/${entity.type}/${entity.slug}`}
  canonicalURL={`https://aetherion-archive.pages.dev/${entity.type}/${entity.slug}`}
>
  <div class="mb-6">
    <a href={`/${entity.type}/`} class="text-[#5a5a6a] hover:text-[#7aa2c8] text-sm transition-colors">&larr; {entity.type.charAt(0).toUpperCase() + entity.type.slice(1)}s</a>
  </div>

  <!-- Header -->
  <header class="mb-8">
    <h1 class="text-3xl md:text-4xl font-bold text-white mb-3">{entity.name}</h1>
    <div class="flex flex-wrap items-center gap-2 mb-3">
      <span class="text-xs uppercase tracking-[0.1em] text-[#5a5a6a] border border-[#2a2a3a] rounded-full px-3 py-0.5">{entity.type}</span>
      <span class={`text-xs uppercase tracking-[0.1em] border rounded-full px-3 py-0.5 ${statusBadge[entity.status] || statusBadge.active}`}>{entity.status}</span>
      {region && <span class="text-xs text-[#5a5a6a] border border-[#2a2a3a] rounded-full px-3 py-0.5">{region}</span>}
      {era && <span class="text-xs text-[#5a5a6a] border border-[#2a2a3a] rounded-full px-3 py-0.5">{era}</span>}
    </div>
    {aliasList.length > 0 && (
      <div class="flex flex-wrap gap-1.5">
        {aliasList.map(a => (
          <span class="text-xs text-[#4a4a5a] italic">{a}</span>
        ))}
      </div>
    )}
  </header>

  <hr class="border-[#1e1e2e] mb-8" />

  <!-- Description -->
  <section class="mb-8">
    <p class="text-[#c8c8d4] text-lg leading-relaxed">{entity.description}</p>
    {contentParagraphs.length > 0 && (
      <div class="mt-5 space-y-4">
        {contentParagraphs.map(p => (
          <p class="text-[#b0b0bc] leading-relaxed">{p}</p>
        ))}
      </div>
    )}
  </section>

  <hr class="border-[#1e1e2e] mb-8" />

  <!-- Connections -->
  <section class="mb-8">
    <h2 class="text-sm uppercase tracking-[0.15em] text-[#4a4a5a] mb-4">Connections</h2>
    {resolvedRelationships.length > 0 && (
      <ul class="space-y-2 mb-4">
        {resolvedRelationships.map((item) => {
          const rel = item.relation;
          const target = item.target;
          if (!rel || !target) return null;
          return <li class="text-sm">
            <span class="text-[#4a4a5a] text-xs uppercase tracking-[0.1em]">{relTypeLabel(rel.type)}</span>
            <span class="text-[#3a3a4a] mx-2">&rarr;</span>
            <a href={`/${target.type}/${target.slug}`} class="text-[#7aa2c8] hover:underline">{target.name}</a>
            <span class="text-[#4a4a5a] text-xs ml-1">({target.type})</span>
          </li>;
        })}
      </ul>
    )}
    {unresolvedRelationships.length > 0 && (
      <div>
        <p class="text-xs uppercase tracking-[0.15em] text-[#3a3a4a] mb-2">Not yet in canon</p>
        <ul class="space-y-1">
          {unresolvedRelationships.map((item) => {
            const rel = item.relation;
            if (!rel) return null;
            return <li class="text-sm text-[#4a4a5a] italic">
              <span class="text-[#3a3a4a] text-xs uppercase tracking-[0.1em]">{relTypeLabel(rel.type)}</span>
              <span class="text-[#3a3a4a] mx-2">&rarr;</span>
              <span class="line-through text-[#3a3a4a]">{item.targetId}</span>
            </li>;
          })}
        </ul>
      </div>
    )}
    {resolvedRelationships.length === 0 && unresolvedRelationships.length === 0 && (
      <p class="text-[#4a4a5a] italic text-sm">No known connections.</p>
    )}
  </section>

  <hr class="border-[#1e1e2e] mb-8" />

  <!-- Attributes -->
  {attrEntries.length > 0 && (
    <details class="border border-[#1e1e2e] rounded-lg group">
      <summary class="cursor-pointer text-sm uppercase tracking-[0.15em] text-[#5a5a6a] px-5 py-3 hover:text-[#7aa2c8] transition-colors list-none flex items-center gap-2 [&::-webkit-details-marker]:hidden">
        <span class="text-[#4a4a5a] text-xs transition-transform group-open:rotate-90">&#x25B6;</span>
        Attributes
      </summary>
      <div class="px-5 pb-5">
        <dl class="divide-y divide-[#1e1e2e]/50">
          {attrEntries.map(([key, val]) => (
            <div class="py-2.5 grid grid-cols-1 sm:grid-cols-[9rem_1fr] gap-1 sm:gap-3">
              <dt class="text-xs uppercase tracking-[0.1em] text-[#5a5a6a] font-mono">{attrLabel(key)}</dt>
              <dd class="text-[#b0b0bc] text-sm font-mono">{attrVal(val)}</dd>
            </div>
          ))}
        </dl>
      </div>
    </details>
  )}

  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    name: entity.name,
    description: entity.description,
    url: `https://aetherion-archive.pages.dev/${entity.type}/${entity.slug}`,
    datePublished: entity.createdAt,
    dateModified: entity.updatedAt,
    publisher: { "@type": "Organization", name: "Aetherion Archive" }
  })}></script>
</BaseLayout>
