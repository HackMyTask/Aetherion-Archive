---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllEntities, getEntityCount, getEntityTypeCounts, getEntityGraph } from '../lib/canon';

const entities = getAllEntities();
const totalCount = getEntityCount();
const typeCounts = getEntityTypeCounts();
const graph = getEntityGraph();

const totalRelationships = entities.reduce((sum, e) => sum + e.relationships.length, 0);

let unresolvedCount = 0;
for (const e of entities) {
  for (const r of e.relationships) {
    if (!graph.has(r.targetId)) unresolvedCount++;
  }
}

const loreHealth = unresolvedCount === 0 ? 'Perfect' : unresolvedCount <= 3 ? 'Stable' : 'Fragile';
const loreColor = loreHealth === 'Perfect' ? 'text-emerald-400' : loreHealth === 'Stable' ? 'text-amber-400' : 'text-red-400';

const featured = [...entities]
  .sort((a, b) => b.relationships.length - a.relationships.length)
  .slice(0, 3);

const typeGrid = [
  { key: 'god', label: 'Gods', icon: '\u{1F31F}' },
  { key: 'kingdom', label: 'Kingdoms', icon: '\u{1F3F0}' },
  { key: 'faction', label: 'Factions', icon: '\u{2694}\u{FE0F}' },
  { key: 'event', label: 'Events', icon: '\u{1F4DC}' },
  { key: 'city', label: 'Cities', icon: '\u{1F3D9}\u{FE0F}' },
  { key: 'religion', label: 'Religions', icon: '\u{1F54D}' },
  { key: 'race', label: 'Races', icon: '\u{1F9CD}' },
  { key: 'monster', label: 'Monsters', icon: '\u{1F409}' },
  { key: 'artifact', label: 'Artifacts', icon: '\u{1F4E7}' },
  { key: 'spell', label: 'Spells', icon: '\u{2728}' },
  { key: 'region', label: 'Regions', icon: '\u{1F30D}' },
];
---

<BaseLayout
  title="Aetherion Archive"
  description="A synthetic fantasy universe engine — a living archive of dark fantasy and fractured light"
  url="https://aetherion-archive.pages.dev/"
  canonicalURL="https://aetherion-archive.pages.dev/"
>
  <!-- Hero -->
  <section class="py-12 md:py-20 text-center border-b border-[#1e1e2e] mb-10">
    <h1 class="text-4xl md:text-6xl font-bold text-[#7aa2c8] tracking-[0.15em] uppercase mb-4">Aetherion Archive</h1>
    <p class="text-sm uppercase tracking-[0.2em] text-[#5a5a6a] mb-8">A synthetic fantasy universe engine</p>
    <div class="flex flex-wrap justify-center gap-6 text-sm">
      <span class="text-[#6b6b7a]"><span class="text-[#7aa2c8] font-semibold">{totalCount}</span> entities</span>
      <span class="text-[#6b6b7a]"><span class="text-[#7aa2c8] font-semibold">{totalRelationships}</span> relationships</span>
      <span class={loreColor + " font-semibold"}>{loreHealth}</span>
    </div>
  </section>

  <!-- Type Grid -->
  <section class="mb-12">
    <h2 class="text-xs uppercase tracking-[0.15em] text-[#4a4a5a] mb-5 text-center">Entity Catalogue</h2>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
      {typeGrid.map((el) => {
        const count = typeCounts[el.key] || 0;
        return (
          <a
            href={`/${el.key}/`}
            class="block border border-[#1e1e2e] rounded-xl p-5 text-center hover:border-[#7aa2c8] hover:shadow-[0_0_12px_rgba(122,162,200,0.08)] transition-all duration-200 group"
          >
            <div class="text-xl mb-2">{el.icon}</div>
            <div class="text-2xl font-bold text-[#c8c8d4] mb-0.5">{count}</div>
            <div class="text-xs uppercase tracking-[0.1em] text-[#5a5a6a]">{el.label}</div>
          </a>
        );
      })}
    </div>
  </section>

  <!-- Featured Entities -->
  {featured.length > 0 && (
    <section class="mb-12">
      <h2 class="text-xs uppercase tracking-[0.15em] text-[#4a4a5a] mb-5 text-center">Most Connected</h2>
      <div class="grid gap-4 sm:grid-cols-3">
        {featured.map((e) => (
          <a
            href={`/${e.type}/${e.slug}`}
            class="block border border-[#1e1e2e] rounded-xl p-5 hover:border-[#7aa2c8] hover:shadow-[0_0_12px_rgba(122,162,200,0.08)] transition-all duration-200 group"
          >
            <h3 class="text-[#c8c8d4] font-semibold text-lg mb-2 group-hover:text-[#7aa2c8] transition-colors">{e.name}</h3>
            <div class="flex flex-wrap gap-1.5 mb-3">
              <span class="text-xs uppercase tracking-[0.1em] text-[#5a5a6a] border border-[#2a2a3a] rounded-full px-2.5 py-0.5">{e.type}</span>
              <span class={`text-xs uppercase tracking-[0.1em] border rounded-full px-2.5 py-0.5 ${e.status === 'active' ? 'bg-emerald-600/15 text-emerald-400 border-emerald-600/20' : e.status === 'deprecated' ? 'bg-red-600/15 text-red-400 border-red-600/20' : e.status === 'archived' ? 'bg-stone-600/15 text-stone-400 border-stone-600/20' : 'bg-amber-600/15 text-amber-400 border-amber-600/20'}`}>{e.status}</span>
            </div>
            <p class="text-[#5a5a6a] text-sm leading-relaxed line-clamp-2">{(e.excerpt || e.description).slice(0, 120)}</p>
            <p class="text-[#4a4a5a] text-xs mt-3">{e.relationships.length} relationship{e.relationships.length === 1 ? '' : 's'}</p>
          </a>
        ))}
      </div>
    </section>
  )}
</BaseLayout>
