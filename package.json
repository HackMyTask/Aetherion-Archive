{
  "name": "aetherion-archive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "init:world": "node --env-file .env --import tsx scripts/init-world.ts",
    "generate:one": "node --env-file .env --import tsx scripts/generate-one.ts",
    "generate:batch": "node --env-file .env --import tsx scripts/generate-batch.ts",
    "validate:canon": "node --env-file .env --import tsx scripts/validate-canon.ts",
    "retry:failed": "node --env-file .env --import tsx scripts/retry-failed.ts",
    "session:stats": "node --env-file .env --import tsx scripts/session-stats.ts",
    "compact:memory": "node --env-file .env --import tsx scripts/compact-memory.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.1.6",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.6"
  }
}
